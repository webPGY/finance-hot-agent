# LangGraph Checkpoint（可与主库共用，也可单独实例）
# DATABASE_URL 同上即可

# LLM
OPENAI_API_KEY="sk-xxx"

# 数据保留天数（清理任务用，默认 30）
RETENTION_DAYS=30

# 首页/排行榜展示条数（默认 10）
HOT_NEWS_COUNT=10

# 抓取数据源：cnbc / yahoo / eastmoney / sina / xueqiu / all
# 例：要看新浪，设置 HOT_NEWS_SOURCE=sina
HOT_NEWS_SOURCE=cnbc

# 时区（调度用）
TZ=Asia/Shanghai
